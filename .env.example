# Copy to .env and adjust. Never commit the real .env file.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus            # change for anything beyond local development
POSTGRES_DB=nexusai
POSTGRES_PORT=5432                 # host port; change if 5432 is already in use

# --- Ports exposed on your machine ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Backend (all backend settings use the NEXUS_ prefix) ---
NEXUS_ENVIRONMENT=local            # local | test | staging | production
NEXUS_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
NEXUS_LOG_JSON=true                # false = human-readable logs while developing
# Used when running the backend directly on your machine (outside Docker):
NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexusai
NEXUS_CORS_ORIGINS=http://localhost:5173

# --- Authentication ---
# Generate a real secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The backend refuses to start in staging/production with the dev default or anything under 32 chars.
NEXUS_JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
NEXUS_ACCESS_TOKEN_MINUTES=15
NEXUS_REFRESH_TOKEN_DAYS=7
NEXUS_COOKIE_SECURE=false          # must be true wherever the site is served over HTTPS
NEXUS_ALLOW_PUBLIC_SIGNUP=true     # false = only existing admins can add users

# --- Tests ---
NEXUS_TEST_DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexusai_test
