# Copy to .env and adjust. Never commit the real .env file.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus            # change for anything beyond local development
POSTGRES_DB=nexusai
POSTGRES_PORT=5432                 # host port; change if 5432 is already in use
REDIS_PORT=6379                    # host port for Redis

# --- Ports exposed on your machine ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Backend (all backend settings use the NEXUS_ prefix) ---
NEXUS_ENVIRONMENT=local            # local | test | staging | production
NEXUS_LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
NEXUS_LOG_JSON=true                # false = human-readable logs while developing
# Used when running the backend directly on your machine (outside Docker):
NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexusai
NEXUS_CORS_ORIGINS=http://localhost:5173

# --- Authentication ---
# Generate a real secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The backend refuses to start in staging/production with the dev default or anything under 32 chars.
NEXUS_JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
NEXUS_ACCESS_TOKEN_MINUTES=15
NEXUS_REFRESH_TOKEN_DAYS=7
NEXUS_COOKIE_SECURE=false          # must be true wherever the site is served over HTTPS
NEXUS_ALLOW_PUBLIC_SIGNUP=true     # false = only existing admins can add users

# --- Redis (login/sign-up rate limiting; the API keeps working if Redis is down) ---
NEXUS_REDIS_URL=redis://localhost:6379/0
NEXUS_RATE_LIMIT_ENABLED=true
NEXUS_LOGIN_RATE_LIMIT_PER_IP=20       # login attempts per minute per IP
NEXUS_LOGIN_FAILURES_PER_ACCOUNT=5     # failed logins per 15 minutes per email
NEXUS_REGISTER_RATE_LIMIT_PER_IP=10    # sign-ups per hour per IP

# --- Documents ---
NEXUS_STORAGE_DIR=./data/uploads       # docker compose uses /data/uploads (a volume)
NEXUS_MAX_UPLOAD_MB=20
NEXUS_CHUNK_SIZE=1200                  # characters (~300 tokens)
NEXUS_CHUNK_OVERLAP=200

# --- Embeddings ---
# hashing = offline and deterministic, NOT semantic (fine for trying things out)
# openai  = real semantic embeddings; needs NEXUS_OPENAI_API_KEY
NEXUS_EMBEDDING_PROVIDER=hashing
NEXUS_EMBEDDING_MODEL=text-embedding-3-small
NEXUS_OPENAI_API_KEY=
# NEXUS_OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint

# --- Answers (AI Chat) ---
# extractive = offline, no LLM: answers quote the best-matching sentences, with citations
# openai     = an OpenAI-compatible chat model writes the answer from the sources; needs the key above
NEXUS_ANSWER_PROVIDER=extractive
NEXUS_CHAT_MODEL=gpt-4o-mini
NEXUS_RETRIEVAL_TOP_K=6                # passages given to the answer step
NEXUS_RETRIEVAL_MIN_SIMILARITY=0.3     # below this, a passage needs a keyword match to count
NEXUS_CHAT_RATE_LIMIT_PER_USER=30      # questions per minute per user

# --- Background worker ---
NEXUS_JOB_MAX_ATTEMPTS=3
NEXUS_JOB_RETRY_BASE_SECONDS=5         # backoff: 5s, 10s, 20s...
NEXUS_JOB_LOCK_TIMEOUT_SECONDS=300     # reclaim jobs from crashed workers after this

# --- Tests ---
NEXUS_TEST_DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexusai_test
NEXUS_TEST_REDIS_URL=redis://localhost:6379/15
