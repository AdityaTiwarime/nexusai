# Copy to terraform.tfvars (git-ignored) and fill in.
region         = "ap-south-1"
domain_name    = "nexusai.example.com"
acme_email     = "you@example.com"
repo_url       = "https://github.com/your-user/nexusai.git"
image_registry = "ghcr.io/your-user"
image_tag      = "0123456789abcdef0123456789abcdef01234567" # a commit CI has built images for

# Optional
# route53_zone_id   = "Z0123456789ABCDEFGHIJ"
# github_repository = "your-user/nexusai"
# openai_api_key    = "sk-..."   # better: TF_VAR_openai_api_key in your shell
