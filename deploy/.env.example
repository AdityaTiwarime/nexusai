# Production settings for deploy/docker-compose.prod.yml.
# On AWS, the EC2 instance writes this file from Secrets Manager at boot (see
# infra/terraform/aws/templates/user_data.sh.tftpl); you don't create it by hand.
# Elsewhere: copy to deploy/.env, fill in, and `chmod 600 .env`.

NEXUS_DOMAIN=nexusai.example.com     # DNS A record must point to the server for HTTPS
ACME_EMAIL=you@example.com           # Let's Encrypt expiry notices
NEXUS_PUBLIC_API_URL=https://nexusai.example.com

NEXUS_IMAGE_REGISTRY=ghcr.io/your-github-user
# NEXUS_IMAGE_TAG is passed by deploy.sh (git commit SHA)

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
REDIS_PASSWORD=
NEXUS_JWT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEXUS_ENCRYPTION_KEY=

NEXUS_ALLOW_PUBLIC_SIGNUP=false
NEXUS_INTEGRATION_ALLOWED_HOSTS=     # e.g. .service-now.com,login.salesforce.com
# NEXUS_EMBEDDING_PROVIDER=openai
# NEXUS_ANSWER_PROVIDER=openai
# NEXUS_OPENAI_API_KEY=
